{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ofe:move-profile:1.0",
  "type": "object",
  "properties": {
    "format": {
      "const": "OFE_MOVE_PROFILE"
    },
    "format_version": {
      "const": "1.0"
    },
    "moves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/move"
      },
      "minItems": 1
    }
  },
  "required": [
    "format",
    "format_version",
    "moves"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "move": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "strike",
            "throw",
            "super",
            "projectile"
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "cancel_into": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "speed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "lifetime": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "kind",
        "windows",
        "cancel_into"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "projectile"
              }
            }
          },
          "then": {
            "required": [
              "speed",
              "lifetime"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "speed"
                  ]
                },
                {
                  "required": [
                    "lifetime"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
