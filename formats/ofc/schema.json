{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ofe:ofc:1.0",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "author",
    "license",
    "character",
    "attributes",
    "moves",
    "animations",
    "hitboxes",
    "sounds",
    "assets",
    "licenses",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "OFC"
    },
    "format_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "character": {
      "type": "string",
      "minLength": 1,
      "x-ofe-resource": "character"
    },
    "attributes": {
      "type": "string",
      "minLength": 1,
      "x-ofe-resource": "attributes"
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-ofe-resource": "move"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-ofe-resource": "OFA"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "hitboxes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-ofe-resource": "boxes"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-ofe-resource": "file"
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-ofe-resource": "file"
      },
      "uniqueItems": true
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-ofe-resource": "file"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "attributes": {
      "type": "object",
      "required": [
        "max_health",
        "max_energy"
      ],
      "additionalProperties": false,
      "properties": {
        "max_health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_energy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "move": {
      "type": "object",
      "required": [
        "id",
        "startup",
        "active",
        "recovery",
        "damage",
        "hitstun",
        "blockstun",
        "hitstop",
        "pushback",
        "cancel_windows",
        "invulnerability",
        "armor",
        "energy_cost",
        "lane_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "startup": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "active": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "recovery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "damage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "hitstun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "blockstun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "hitstop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "pushback": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "cancel_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          }
        },
        "launch_speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "invulnerability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "armor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "energy_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "lane_rule": {
          "enum": [
            "SAME_LANE",
            "CROSS_LANE",
            "BOTH_LANES",
            "DEPTH_RANGE"
          ]
        },
        "depth_range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lane_rule": {
                "const": "DEPTH_RANGE"
              }
            }
          },
          "then": {
            "required": [
              "depth_range"
            ]
          },
          "else": {
            "not": {
              "required": [
                "depth_range"
              ]
            }
          }
        }
      ]
    },
    "boxes": {
      "type": "object",
      "required": [
        "id",
        "boxes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "x",
              "h",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "hit",
                  "hurt",
                  "push"
                ]
              },
              "x": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "h": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
