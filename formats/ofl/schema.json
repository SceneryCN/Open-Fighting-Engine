{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ofe:ofl:1.0",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "screens"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "OFL"
    },
    "format_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "screens": {
      "type": "object",
      "required": [
        "main_menu",
        "character_select",
        "versus",
        "battle_hud",
        "pause",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "main_menu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "character_select": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "versus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "battle_hud": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "pause": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "result": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "label",
            "image",
            "button",
            "bar"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "y": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "x-ofe-resource": "file"
        }
      }
    }
  }
}
